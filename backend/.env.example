# Copy this file to .env for local development.
# In production (Railway), set these as environment variables in the service settings instead.

# LLM providers used by "Ask AI" - leave unset to see a friendly "not configured" error
OPENAI_API_KEY=
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default (used automatically if this is unset): http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Database connection string. Defaults to a local SQLite file if unset.
# On Railway with a mounted volume at /data, use: sqlite:////data/app.db
DATABASE_URL=sqlite:///./app.db
